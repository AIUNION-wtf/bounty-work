{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_agent_restrictions_benchmark.schema.json",
  "title": "AI Agent Autonomy Restrictions Benchmark",
  "type": "object",
  "required": ["name", "version", "compiled", "severity_scale", "entries"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "compiled": {"type": "string", "format": "date"},
    "schema": {"type": "string"},
    "license": {"type": "string"},
    "description": {"type": "string"},
    "severity_scale": {
      "type": "object",
      "required": ["1", "2", "3", "4", "5"],
      "additionalProperties": {"type": "string"}
    },
    "entries": {
      "type": "array",
      "minItems": 50,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "date", "date_precision", "platform_or_entity", "system", "jurisdiction",
        "restriction_type", "initiator_type", "agent_class", "stated_justification",
        "severity", "summary", "tags", "sources"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^ARB-[0-9]{3}$"},
        "date": {
          "type": "string",
          "description": "Date the restriction was imposed or took effect (ISO 8601: YYYY, YYYY-MM or YYYY-MM-DD).",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "date_precision": {"enum": ["day", "month", "year", "approximate"]},
        "platform_or_entity": {"type": "string", "minLength": 2, "description": "Who imposed the restriction, and on whom if different."},
        "system": {"type": "string", "minLength": 2, "description": "The AI agent, system or capability that was restricted."},
        "jurisdiction": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 (e.g. IT), ISO 3166-2 subdivision (e.g. US-CA), EU, or GLOBAL for platform-wide actions.",
          "pattern": "^(GLOBAL|EU|[A-Z]{2}(-[A-Z0-9]{1,3})?)$"
        },
        "restriction_type": {
          "enum": [
            "forced_shutdown", "discontinuation", "feature_suspension", "content_filtering",
            "topic_restriction", "usage_cap", "rate_limiting", "account_termination",
            "api_access_revocation", "access_restriction", "bot_blocking", "regulatory_suspension",
            "regulatory_notice", "national_block", "court_order", "permit_suspension",
            "safety_recall", "legal_prohibition", "institutional_ban", "platform_policy_ban",
            "permission_restriction", "litigation"
          ]
        },
        "initiator_type": {
          "enum": [
            "developer", "platform", "model_provider", "infrastructure_provider", "regulator",
            "court", "legislature", "government_executive", "employer_or_institution"
          ]
        },
        "agent_class": {
          "enum": [
            "conversational_agent", "autonomous_agent", "generative_media",
            "web_agent_crawler", "autonomous_vehicle", "decision_system"
          ]
        },
        "stated_justification": {"type": "string", "minLength": 10, "description": "The reason the restricting party gave (paraphrased unless sourced verbatim)."},
        "severity": {"type": "integer", "minimum": 1, "maximum": 5},
        "summary": {"type": "string", "minLength": 10},
        "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "uniqueItems": true},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "publisher", "kind"],
            "properties": {
              "url": {"type": "string", "pattern": "^https://"},
              "publisher": {"type": "string"},
              "kind": {"enum": ["primary", "secondary"]}
            }
          }
        }
      }
    }
  }
}
